{
  "name": "studio-website",
  "description": "REVATI Studio Website",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "license": "BSD-3-Clause",
  "author": "REVATI Studio",
  "contributors": [
    "Rinrin.rs <rinrin0413.rs@gmail.com>",
    "RetoRuto9900K <tutinoko2048@gmail.com>"
  ],
  "homepage": "https://studio.revati.jp",
  "repository": {
    "type": "git",
    "url": "https://github.com/revati-jp/studio-website.git"
  },
  "bugs": {
    "url": "https://github.com/revati-jp/studio-website/issues"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run licenses && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "licenses": "node ./scripts/collect-licenses.ts",
    "format": "prettier . --write",
    "lint": "prettier --check . && eslint \"src/**/*.{js,ts,astro}\"",
    "lint:fix": "prettier --check . && eslint \"src/**/*.{js,ts,astro}\" --fix",
    "check": "astro sync && astro check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@astrojs/svelte": "^8.1.2",
    "@threlte/core": "^8.6.0",
    "@threlte/extras": "^9.21.1",
    "astro": "^6.4.8",
    "embla-carousel": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "sass": "^1.104.0",
    "sharp": "^0.34.5",
    "svelte": "^5.57.0",
    "three": "^0.184.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.4",
    "@quantco/pnpm-licenses": "^2.2.3",
    "@sveltejs/kit": "^2.70.3",
    "@types/node": "^25.9.5",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.12.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-svelte": "^3.5.2",
    "rollup-plugin-license": "^3.7.1",
    "svelte-preprocess": "^6.0.5",
    "typescript-eslint": "^8.61.0",
    "wrangler": "^4.130.0"
  },
  "packageManager": "pnpm@12.3.4",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "error"
    }
  }
}

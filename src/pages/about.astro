---
import Layout from "../layouts/Layout.astro";
import MusicPlayer from "../components/music/MusicPlayer.svelte";

const SERVICES = [
  "映像制作・動画編集",
  "BGM・楽曲制作",
  "デザイン・イラスト制作",
  "通訳・翻訳",
  "ソフトウェア・Discord ボット・Web 開発",
];

const PROCESS = [
  {
    title: "お問い合わせ",
    desc: "まずは Discord サーバーにてお気軽にご相談ください。",
  },
  {
    title: "ヒアリング・お見積もり",
    desc: "ご要望を詳しくお伺いし、金額をご提案します。",
  },
  {
    title: "制作開始",
    desc: "ご提案内容に同意いただけましたら、制作を開始します。",
  },
  {
    title: "ご確認・修正",
    desc: "制作物をご確認いただき、必要に応じて修正を行います。",
  },
  { title: "納品", desc: "最終的な制作物をご指定の形式で納品いたします。" },
];

const FAQ = [
  {
    question: "見積もりは無料ですか？",
    answer: "はい、お見積もりやご相談は無料です。",
  },
  {
    question: "予算が確定していませんが、相談可能ですか？",
    answer:
      "可能です。ご予算に合わせて、実現可能なクオリティや構成案を逆算してご提案いたします。",
  },
  {
    question: "修正回数に制限はありますか？",
    answer:
      "基本料金内で2回までの修正を承ります。3回目以降、または当初の要件から大幅に変更となる場合は、追加費用をいただく場合がございます。",
  },
  {
    question: "個人でも依頼は可能ですか？",
    answer:
      "はい、もちろんです。法人・個人、活動規模を問わず、あらゆるクリエイティブのご相談を承っております。",
  },
];

export const TITLE = "REVATI Studio";
export const SUBTITLE = "/ Creative Studio";
---

<Layout title="ABOUT">
  <div class="container">
    <section>
      <h1>
        <span class="title">{TITLE}</span>
        <span class="ruby">[レバティ・スタジオ]</span>
        <br class="title-br" />
        <span class="subtitle">{SUBTITLE}</span>
      </h1>
      <p class="theme">
        <span class="concept">“創造性のすべてを、ここに。“</span>
        あらゆるクリエイティブをワンストップで
      </p>
      <div>
        <h2>主要なサービス領域</h2>
        <ul>
          {SERVICES.map((s) => (
            <li class="service">{s}</li>
          ))}
        </ul>
      </div>
      <div class="process-container">
        <h2>手続き</h2>
        <ul class="process">
          {PROCESS.map((step, i) => (
            <li class="step">
              <div class="step-num">{i + 1}</div>
              <div class="step-content">
                <h3 class="step-title">{step.title}</h3>
                <p class="step-desc">{step.desc}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="faq">
        <h2>よくある質問</h2>
        <div class="faq-list">
          {FAQ.map((item) => (
            <div class="faq-item">
              <h3 class="faq-question">{item.question}</h3>
              <p class="faq-answer">{item.answer}</p>
            </div>
          ))}
        </div>
        <div class="faq-message">
          ジャンルの制限はございません。お客様が形にしたい想いやコンセプトを、理想的な形でデザインに落とし込みます。まずは「何を作りたいか」を、お気軽にお聞かせください。
        </div>
      </div>
    </section>
  </div>

  <MusicPlayer client:load transition:name="music-player" transition:persist />
</Layout>

<style lang="scss">
  .container {
    display: flex;
    flex-direction: column;
  }

  section {
    max-width: 742px;
    margin: 48px auto;
    margin-bottom: 90px;
    position: relative;
    right: 78px;
  }

  h1 {
    font-size: 54px;
    font-weight: 400;
    letter-spacing: 1px;
    line-height: 12px;
    margin-bottom: 0;
  }

  .title,
  .subtitle {
    @include font-special-gothic-expanded-one;
  }

  .subtitle,
  .ruby {
    font-size: 17px;
    letter-spacing: 1.5px;
  }

  .ruby {
    margin-left: 8px;
  }

  .subtitle {
    margin-left: 5px;
    color: $color-accent;
    letter-spacing: 4px;
  }

  p {
    margin-block: 44px;
  }

  .concept {
    display: block;
    font-size: 28px;
    font-style: italic;
    margin-bottom: 14px;
  }

  h2 {
    font-size: 24px;
    font-weight: 400;
    padding: 1px 14px;
    border-left: 6px solid $color-accent;
  }

  .service {
    margin-block: 6px;
  }

  .process-container {
    margin-top: 68px;
  }

  .process {
    list-style: none;
    padding-left: 0;
    margin-top: 20px;
  }

  .step {
    display: flex;
    margin-block: 20px;
    gap: 14px;
    align-items: flex-start;
  }

  .step-num {
    display: inline-flex;
    height: 42px;
    font-size: 26px;
    font-weight: 900;
    position: relative;
    top: 7px;
    color: $color-secondary;
    aspect-ratio: 1;
    background-color: $color-accent;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
  }

  .step-content {
    display: flex;
    flex-direction: column;
  }

  .step-title {
    font-size: 22px;
    font-weight: 400;
    margin: 0;
  }

  .step-desc {
    font-size: 15px;
    margin: 0;
    opacity: 0.8;
  }

  .faq {
    margin-top: 68px;
  }

  .faq-list {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    padding-block: 18px;
    border-bottom: 1px solid rgba($color-accent, 0.3);

    &:first-child {
      border-top: 1px solid rgba($color-accent, 0.3);
    }
  }

  .faq-question {
    font-size: 18px;
    font-weight: 400;
    margin: 0 0 8px;

    &::before {
      content: "Q. ";
      color: $color-accent;
      font-weight: 700;
    }
  }

  .faq-answer {
    font-size: 15px;
    margin: 0;
    opacity: 0.8;
    padding-left: 24px;

    &::before {
      content: "A. ";
      font-weight: 700;
    }
  }

  .faq-message {
    margin-top: 28px;
    font-size: 14px;
    opacity: 0.65;
    margin-bottom: 0;
  }

  // レイアウト制御用
  @media screen and (max-width: 880px) {
    .container {
      max-width: 531px;
      margin: 0 auto;
    }

    section {
      max-width: initial;
      margin: 12px 20px;
      margin-bottom: 58px;
      right: 0;
    }

    .ruby {
      position: relative;
      top: 7px;
    }

    .subtitle {
      position: relative;
      top: 8px;
    }
  }

  @include sp {
    .container {
      max-width: 440px;
    }

    h1 {
      font-size: 39px;
      line-height: 34px;
    }

    .title-br {
      display: none;
    }

    .subtitle,
    .ruby {
      font-size: 14px;
    }

    .ruby {
      display: block;
      margin-left: 8px;
    }

    .subtitle {
      letter-spacing: 4px;
    }

    p,
    li {
      font-size: 18px;
    }

    p {
      margin-block: 62px;
    }

    .theme {
      font-size: 17px;
    }

    .concept {
      font-size: 24px;
    }

    h2 {
      font-size: 21px;
      padding: 0 12px;
    }

    .process-container {
      margin-top: 54px;
    }

    .step-title {
      font-size: 19px;
    }

    .step-desc {
      font-size: 14px;
    }

    .faq-question {
      font-size: 16px;
    }

    .faq-answer {
      font-size: 13px;
    }

    .faq-message {
      font-size: 13px;
    }
  }
</style>
